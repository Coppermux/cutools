<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp"
    tools:context=".ui.securitystorage.SecurityStorageToolScreen">

    <TextView
        android:id="@+id/securityStorageTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Security &amp; Storage"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/securityStorageStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="State: —"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/securityStorageTitle" />

    <TextView
        android:id="@+id/securityStorageTargetText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Target: —"
        android:textSize="12sp"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/securityStorageStatusText" />

    <!-- Top tab navigation (Security, Storage Quota, IndexedDB, Cache Storage) -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/securityStorageTabGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:layout_constraintTop_toBottomOf="@id/securityStorageTargetText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.chip.Chip
            android:id="@+id/securityStorageTabSecurity"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="Security" />

        <com.google.android.material.chip.Chip
            android:id="@+id/securityStorageTabQuota"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="Storage Quota" />

        <com.google.android.material.chip.Chip
            android:id="@+id/securityStorageTabIndexedDb"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="IndexedDB" />

        <com.google.android.material.chip.Chip
            android:id="@+id/securityStorageTabCache"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="Cache Storage" />
    </com.google.android.material.chip.ChipGroup>

    <EditText
        android:id="@+id/securityStorageOriginInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Origin (e.g. https://example.com/)"
        android:inputType="textUri"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/securityStorageTabGroup"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- UNSUPPORTED / UNAVAILABLE / FAILED banner -->
    <TextView
        android:id="@+id/securityStorageBannerText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#B3261E"
        android:textSize="12sp"
        android:background="#FFEBEE"
        android:padding="6dp"
        android:visibility="gone"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/securityStorageOriginInput" />

    <TextView
        android:id="@+id/securityStorageSummaryText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp"
        android:textColor="#616161"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/securityStorageBannerText" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/securityStorageRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:scrollbars="vertical"
        app:layout_constraintTop_toBottomOf="@id/securityStorageSummaryText"
        app:layout_constraintBottom_toTopOf="@id/securityStorageActionRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/securityStorageActionRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/securityStoragePrimaryButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Enable" />

        <Button
            android:id="@+id/securityStorageSecondaryButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="Disable" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>