# Suppress the warning about the use of the word "master" for branch naming conventions.
# The word is used historically and we don't want it to be confused with a reference to a person.

# This is a standalone shell script that runs the Gradle wrapper.
# It resolves the location of the wrapper jar and then invokes it.

set -e

# Resolve the location of the script
APP_HOME=$(cd "$(dirname "$0")" || exit 1 && pwd)
APP_HOME=$(cd "$APP_HOME" || exit 1; pwd)

# Find java
if [ -n "$JAVA_HOME" ]; then
    JAVACMD="$JAVA_HOME/bin/java"
else
    JAVACMD="java"
fi

WRAPPER_JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

if [ ! -f "$WRAPPER_JAR" ]; then
    echo "Gradle wrapper jar not found: $WRAPPER_JAR"
    exit 1
fi

exec "$JAVACMD" -cp "$WRAPPER_JAR" org.gradle.wrapper.GradleWrapperMain "$@"
